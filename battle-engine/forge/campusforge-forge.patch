@@ -0,0 +1,16 @@
+package forge.game;
+
+/**
+ * Master switch for noisy engine debug traces. All {@code [HPC]}, {@code [PSA]}
+ * and {@code [payManaCost]} log lines are gated behind
+ * {@code -Dforge.debug.traces=true} (off by default).
+ */
+public final class ForgeDebug {
+
+    private ForgeDebug() {
+    }
+
+    public static boolean traces() {
+        return Boolean.getBoolean("forge.debug.traces");
+    }
+}
