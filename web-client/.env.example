# Copy to .env.local and adjust for your deployment.
# Supabase project (hosted). Replace values with your project's:
#   VITE_SUPABASE_URL     (Project Settings -> API -> Project URL)
#   VITE_SUPABASE_ANON_KEY (Project Settings -> API -> publishable key)
VITE_SUPABASE_URL=https://prjsiywvhxqnsvsmfgxm.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_CI-gegnlyhVoOfHr-1SEmw__J_BDZZ6

# Battle engine (standalone Forge service). Empty string = same-origin; for a
# deployed frontend set this to the engine origin you can reach over HTTPS/WSS
# (e.g. a Cloudflare Tunnel URL). WebSocket URL is derived from it.
VITE_BATTLE_ENGINE_URL=http://localhost:17175